# Copy to .env. Replace the paths with this checkout. Secrets stay in .env only.
# Admin stores variable names, never key values.

SCAN_ROOT=/path/to/komatose
DATABASE_URL=/path/to/komatose/data/scan.db
# SCAN_DATA_DIR=/path/to/komatose/data

# npm start. The dev server is always 127.0.0.1:5173.
PORT=3847
HOST=127.0.0.1

# Comma-separated origins allowed to submit forms. Empty is fine on loopback.
# SCAN_TRUSTED_ORIGINS=https://scan.example.com,http://scan.example.com
SCAN_TRUSTED_ORIGINS=

# Caddyfile.scan reads these. The app does not. Export them for Caddy, not only here.
# SCAN_SITE_ADDRESS=scan.example.com
# SCAN_PORT=3847

# PyTorch thread count and the fraction of the visible HIP device it may use.
SCAN_MODEL_THREADS=4
SCAN_GPU_MEMORY_FRACTION=0.4

# Remote chat. The provider catalog reads the matching name via env (src/lib/remoteProviders.ts).
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# PERPLEXITY_API_KEY=
# CEREBRAS_API_KEY=
# SAMBANOVA_API_KEY=
# NVIDIA_API_KEY=
# HF_TOKEN=
# HYPERBOLIC_API_KEY=
# NOVITA_API_KEY=
# AZURE_OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_INTL_API_KEY=
# MINIMAX_API_KEY=
# BAICHUAN_API_KEY=
# YI_API_KEY=
# SILICONFLOW_API_KEY=
# HUNYUAN_API_KEY=
# ARK_API_KEY=
# MODELSCOPE_API_KEY=
# PPIO_API_KEY=
# INFINI_API_KEY=
# STEPFUN_API_KEY=
# QIANFAN_API_KEY=
# API360_API_KEY=
# SPARK_API_KEY=
# MIMO_API_KEY=

# Everything below is an optional override. Leave it unset to follow Admin and the built-in default.

# Local OpenAI-compatible chat. Unset URL probes http://127.0.0.1:8081/v1.
# LLAMASWAP_URL=http://127.0.0.1:8081/v1
# LLAMASWAP_MODEL=
# LLAMASWAP_API_KEY=

# PaddleOCR worker.
# PADDLEOCR_PYTHON=/path/to/komatose/.venv-ocr/bin/python
# PADDLEOCR_WORKER=/path/to/komatose/ocr/worker.py

# Text detection. Admin → Models wins once saved. Env applies only until then.
# SCAN_DETECTOR=rtdetr
# SCAN_DETECT_CONF=0.20
# SCAN_DETECT_TILE=690
# SCAN_DETECT_DEVICE=auto
# SCAN_DETECT_THREADS=0
# SCAN_RTDETR_FILE=detector.onnx
# SCAN_DETECT_CTD_SUPPLEMENT=1
# SCAN_COO=auto
# SCAN_COO_CONF=0.60
# SCAN_COO_THREADS=4
# SCAN_COO_MODEL=/path/to/dbnetpp-coo.pt
# SCAN_KOHARU_DETECT=auto
# SCAN_MASK_ENGINE=auto
# SCAN_KOHARU_DIR=/path/to/komatose/data/models/koharu-text-sam-ts-l
# SCAN_KOHARU_WEIGHTS=/path/to/model.safetensors
# SCAN_KOHARU_HISAM_ROOT=/path/to/hi-sam-source

# Recognition.
# SCAN_OCR_UPSCALE=auto
# SCAN_OCR_MIN_SCORE=0.35
# SCAN_OCR_LANG=japanese
# SCAN_OCR_DEVICE=cpu
# SCAN_OCR_EAGER=1

# Review servers.
# SCAN_REVIEW_MODELS_DIR=/path/to/komatose/data/models/review
# SCAN_REVIEW_PYTHON=/path/to/komatose/.venv-review/bin/python
# SCAN_REVIEW_LLAMA_SERVER=/path/to/llama-server
# Optional override. When unset, Komatose runs the nvtop it builds under
# data/tools/nvtop (Admin → Hardware & services → Build nvtop). That build is
# patched so a snapshot names each card by PCI address and reports GTT
# separately from VRAM. A system nvtop is not used.
# SCAN_NVTOP=/path/to/nvtop
# SCAN_REVIEW_THREADS=8
# SCAN_REVIEW_DEVICE=Vulkan2
# SCAN_REVIEW_PADDLE_PORT=18081
# SCAN_REVIEW_QWEN_PORT=18082
# SCAN_REVIEW_HAYAI_PORT=18083
# SCAN_REVIEW_MANGA_PORT=18085

# Translators. Per model, {PREFIX} is SCAN_TRANSLATION_HY, _CAT, _HY7, _KOEN,
# _OPUS_JAEN, _SHISA, _SUGOI, _TG4, or _TG12. Suffixes: _URL, _MODEL, _API_KEY,
# plus _GGUF (llama.cpp) or _CKPT (PyTorch).
# SCAN_TRANSLATION_MODELS_DIR=/path/to/komatose/data/models/translation
# SCAN_TRANSLATION_PYTHON=/path/to/komatose/.venv-review/bin/python
# SCAN_TRANSLATION_LLAMA_SERVER=/path/to/llama-server
# SCAN_TRANSLATION_DEVICE=
# SCAN_TRANSLATION_THREADS=8

# GPU layout. Unset follows Admin → Hardware (data/gpu-mode.json).
# SCAN_GPU_MODE=
# SCAN_GPU_NAME=
# SCAN_HIP_VISIBLE_DEVICES=2
# SCAN_LLM_PORT=18080
# SCAN_LLM_DEVICE=Vulkan1
# SCAN_LLM_CONTEXT=131072
# SCAN_LLM_MTP=3
# SCAN_LLM_MODELS_DIR=/path/to/qwen-gguf
# SCAN_LLM_MODEL=/path/to/model.gguf
# SCAN_LLM_MMPROJ=/path/to/mmproj.gguf
# SCAN_LLM_CHAT_TEMPLATE=/path/to/template.jinja
# SCAN_GEMMA4_MODELS_ROOT=/path/to/unsloth
# SCAN_GEMMA4_MODELS_DIR=/path/to/gemma-4-26B-A4B-it-GGUF
# SCAN_GEMMA4_MODEL=/path/to/model.gguf
# SCAN_GEMMA4_MMPROJ=/path/to/mmproj.gguf
# SCAN_GEMMA4_MTP=/path/to/mtp.gguf
# SCAN_GEMMA4_MTP_DRAFT=4
# SCAN_GEMMA4_PORT=18086
# SCAN_GEMMA4_DEVICE=Vulkan1
# SCAN_GEMMA4_CONTEXT=131072
# SCAN_GEMMA4_IMAGE_TOKENS=1120
# SCAN_GEMMA4_IMAGE_MAX_TOKENS=1120
# SCAN_GEMMA4_VISION_BATCH=2048
# SCAN_MANAGED_IDLE_SECONDS=300

# Headless CLI agents. One executable path or command name, not a shell line.
# GROK_BIN=/path/to/grok
# GROK_MODEL=
# CODEX_BIN=/path/to/codex
# CODEX_MODEL=
# CURSOR_BIN=/path/to/cursor-agent
# CURSOR_AGENT_BIN=

# Local artwork editor (Qwen-Image-Edit 2511). SCAN_IMAGE_EDIT_<KEY> overrides
# SCAN_IMAGE_<KEY>. Keys: STEPS, CFG, DENOISE, FLOW_SHIFT, MIN_SIDE, LORAS.
# Lightning uses SCAN_IMAGE_EDIT_LIGHTNING_<KEY> for STEPS, CFG, and LORAS.
# SEED is SCAN_IMAGE_SEED only.
# SCAN_IMAGE_MODELS_DIR=/path/to/komatose/data/models/image
# SCAN_IMAGE_EDIT_MODEL_DIR=/path/to/qwen-image-edit-2511
# SCAN_IMAGE_EDIT_TEXT_ENCODER_DIR=
# SCAN_IMAGE_EDIT_TEXT_ENCODER=
# SCAN_IMAGE_SD_SERVER=/path/to/sd-server
# SCAN_IMAGE_DEVICE=Vulkan1
# SCAN_IMAGE_EDIT_PORT=18092
# SCAN_IMAGE_THREADS=8
# SCAN_IMAGE_SEED=
# SCAN_IMAGE_LORAS_DIR=/path/to/loras
# SCAN_IMAGE_IDLE_SECONDS=180
# SCAN_IMAGE_OFFLOAD_TO_CPU=0

# Page-image proofreading. Unset hides those tools.
# SCAN_PROOFREAD_SERVICE_URL=http://127.0.0.1:9231
# SCAN_PROOFREAD_SERVICE_TOKEN=

# Cleaning / segmentation venv and weights.
# SCAN_WORKFLOW_PYTHON=/path/to/komatose/.venv-workflow/bin/python
# SCAN_SAM_CHECKPOINT=/path/to/sam2.1_hiera_small.pt
# SCAN_BIG_LAMA_CHECKPOINT=/path/to/lama_large_512px.ckpt
# SCAN_TORCH_INDEX=
# HF_HOME=/path/to/huggingface-cache
