{
  "version": 1,
  "id": "d1-3b",
  "kind": "model",
  "name": "Liquid AI d1-3B Q8",
  "revision": "1",
  "model": "d1-3b",
  "access": "local_http",
  "adapter": {
    "id": "systemone"
  },
  "dependencies": [
    "llama-decider"
  ],
