{
  "version": 1,
  "id": "rtdetr",
  "name": "RT-DETR",
  "revision": "1",
  "access": "local_http",
  "adapter": {
    "id": "native-detector"
  },
  "config": {
    "backend": "rtdetr"
  },
  "service": {
    "id": "ocr-worker",
    "resource": "native-image-workers"
  },
  "setup": {
    "executable": "{root}/.venv-ocr/bin/python",
    "args": [
      "{root}/scripts/install-detect-models.py",
      "--model",
      "rtdetr"
    ],
    "executableEnv": "PADDLEOCR_PYTHON"
  },
  "dependencies": [
    "env-ocr"
  ],
  "environment": [
    "PADDLEOCR_PYTHON",
    "SCAN_OCR_MODELS_DIR",
    "HF_HOME"
  ],
  "artifactDirectories": [
    {
      "path": "{home}/.cache/huggingface",
      "rootEnv": "HF_HOME",
      "subdirectory": "hub/models--ogkalu--comic-text-and-bubble-detector"
    }
  ]
}
