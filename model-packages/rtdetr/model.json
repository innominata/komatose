{
  "version": 1,
  "id": "rtdetr",
  "name": "RT-DETR",
  "revision": "2",
  "access": "local_http",
  "adapter": {
    "id": "native-detector"
  },
  "config": {
    "backend": "rtdetr"
  },
  "service": {
    "id": "cleaning-worker",
    "resource": "native-image-workers"
  },
  "setup": {
    "executable": "{root}/.venv-workflow/bin/python",
    "args": [
      "{root}/scripts/install-detect-models.py",
      "--model",
      "rtdetr"
    ],
    "executableEnv": "SCAN_WORKFLOW_PYTHON"
  },
  "dependencies": [
    "env-workflow",
    "env-ocr"
  ],
  "environment": [
    "PADDLEOCR_PYTHON",
    "SCAN_OCR_MODELS_DIR",
    "HF_HOME",
    "SCAN_WORKFLOW_PYTHON",
    "SCAN_DETECT_DEVICE"
  ],
  "artifactDirectories": [
    {
      "path": "{home}/.cache/huggingface",
      "rootEnv": "HF_HOME",
      "subdirectory": "hub/models--ogkalu--comic-text-and-bubble-detector"
    }
  ]
}
