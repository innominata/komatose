{
  "version": 1,
  "id": "qwen-image-edit-2511-lightning",
  "name": "Qwen Image Edit 2511 Lightning",
  "revision": "1",
  "access": "local_http",
  "adapter": {
    "id": "image-editor"
  },
  "config": {
    "backend": "qwen-image-edit-2511-lightning",
    "aliases": [
      "qwen-image-edit-lightning"
    ]
  },
  "service": {
    "id": "image-editor-service"
  },
  "setup": {
    "executable": "python3",
    "args": [
      "{root}/scripts/install-image-edit-model.py",
      "--lightning"
    ]
  },
  "dependencies": [
    "qwen-image-edit-2511"
  ],
  "environment": [
    "SCAN_IMAGE_MODELS_DIR",
    "SCAN_IMAGE_LORAS_DIR",
    "SCAN_REVIEW_LLAMA_SERVER"
  ],
  "artifactDirectories": [
    {
      "path": "{root}/data/models/image/loras/Qwen-Image-Edit-2511-Lightning-8steps-V1.0-bf16.safetensors"
    }
  ]
}
