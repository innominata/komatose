{
  "version": 1,
  "id": "qwen-image-edit-2511-q2",
  "name": "Qwen Image Edit 2511 Q2_K",
  "revision": "1",
  "access": "local_http",
  "adapter": {
    "id": "image-editor"
  },
  "config": {
    "backend": "qwen-image-edit-2511-q2",
    "aliases": [
      "qwen-image-edit-q2"
    ]
  },
  "service": {
    "id": "image-editor-service"
  },
  "setup": {
    "executable": "python3",
    "args": [
      "{root}/scripts/install-image-edit-model.py",
      "--quant",
      "q2_k"
    ]
  },
  "dependencies": [
    "env-workflow"
  ],
  "environment": [
    "SCAN_IMAGE_MODELS_DIR",
    "SCAN_REVIEW_LLAMA_SERVER"
  ],
  "artifactDirectories": [
    {
      "path": "{root}/data/models/image/qwen-image-edit-2511/qwen-image-edit-2511-Q2_K.gguf"
    }
  ]
}
