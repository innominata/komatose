{
  "version": 1,
  "id": "env-ocr",
  "name": "env-ocr",
  "revision": "1",
  "kind": "runtime",
  "access": "local_http",
  "adapter": {
    "id": "environment"
  },
  "artifacts": [
    "{root}/.venv-ocr/bin/python"
  ],
  "setup": {
    "executable": "python3",
    "args": [
      "{root}/scripts/setup-python-env.py",
      "--env",
      "ocr"
    ]
  }
}
