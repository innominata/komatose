{
  "version": 1,
  "id": "qwen-image-edit-2511-q3",
  "name": "Qwen Image Edit 2511 Q3_K_M",
  "revision": "1",
  "access": "local_http",
  "adapter": {
    "id": "image-editor"
  },
  "config": {
