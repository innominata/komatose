{
  "version": 1,
  "id": "migan",
  "name": "MI-GAN",
  "revision": "1",
  "access": "local_http",
  "adapter": {
    "id": "workflow-image"
  },
  "config": {
    "backend": "migan"
  },
  "service": {
    "id": "cleaning-worker",
    "resource": "native-image-workers"
  },
  "setup": {
    "executable": "{root}/.venv-workflow/bin/python",
    "args": [
      "{root}/scripts/install-clean-models.py",
      "--model",
      "migan"
    ],
    "executableEnv": "SCAN_WORKFLOW_PYTHON"
  },
  "dependencies": [
    "env-workflow"
  ],
  "environment": [
    "SCAN_WORKFLOW_PYTHON",
    "SCAN_ROOT",
    "SCAN_DATA_DIR",
    "SCAN_WORKFLOW_MODELS_DIR"
  ],
  "artifactDirectories": [
    {
      "path": "{root}/data/models/workflow",
      "rootEnv": "SCAN_WORKFLOW_MODELS_DIR",
      "subdirectory": "migan"
    }
  ]
}
