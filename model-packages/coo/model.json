{
  "version": 1,
  "id": "coo",
  "name": "COO",
  "revision": "1",
  "access": "local_http",
  "adapter": {
    "id": "workflow-image"
  },
  "config": {
    "backend": "coo"
  },
  "service": {
    "id": "cleaning-worker",
    "resource": "native-image-workers"
  },
  "setup": {
    "executable": "{root}/.venv-workflow/bin/python",
    "args": [
      "{root}/scripts/install-coo.py"
    ],
    "executableEnv": "SCAN_WORKFLOW_PYTHON"
  },
  "dependencies": [
    "env-workflow"
  ],
  "environment": [
    "SCAN_WORKFLOW_PYTHON",
    "SCAN_WORKFLOW_MODELS_DIR"
  ]
}
